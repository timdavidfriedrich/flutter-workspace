#!/usr/bin/env bash
# fsg — thin dispatcher for the flutter-workspace scripts.
#
# It maps a subcommand to a script in the repo and pipes it through bash with
# every remaining argument passed on untouched. There is no logic here on
# purpose: the scripts stay the single source of truth, so a new flag in
# setup.sh or add-feature.sh works immediately without touching fsg.
set -euo pipefail

VERSION="1.0.0"
REPO="timdavidfriedrich/flutter-workspace"
REF="${FSG_REF:-main}"
BASE_URL="${FSG_BASE_URL:-https://raw.githubusercontent.com/$REPO/$REF}"

usage() {
  cat <<USAGE
fsg $VERSION — Flutter workspace scaffolding

Usage:
  fsg create <args>         scaffold a new project          (setup.sh)
  fsg add-feature <name>    add a feature package           (add-feature.sh)
  fsg doctor                check the local prerequisites
  fsg update                update fsg itself
  fsg --version             print the version

Every argument after the subcommand is passed to the script unchanged, so
\`fsg create --help\` shows that script's own options.

Examples:
  fsg create --name my_app --org com.example --target ~/Code/my_app
  fsg add-feature scan

Environment:
  FSG_REF        branch or tag to fetch scripts from (default: main)
  FSG_BASE_URL   override the base url entirely (for local testing)
USAGE
}

die() { echo "fsg: $1" >&2; exit 1; }

run_script() {
  local script="$1"; shift
  command -v curl >/dev/null || die "curl not on PATH"
  local url="$BASE_URL/$script" tmp
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN
  curl -fsSL "$url" -o "$tmp" || die "cannot fetch $url"
  head -1 "$tmp" | grep -q '^#!' || die "$url is not a script — check FSG_REF/FSG_BASE_URL"
  bash "$tmp" "$@"
}

doctor() {
  local ok=0
  check() {
    printf '  %-22s ' "$1"
    if command -v "$2" >/dev/null; then
      echo "$(command -v "$2")"
    else
      echo "MISSING"; ok=1
    fi
  }
  echo "fsg $VERSION"
  echo "  scripts from         $BASE_URL"
  check "curl" curl
  check "git" git
  check "fvm" fvm
  if command -v fvm >/dev/null; then
    printf '  %-22s ' "flutter sdks (fvm)"
    local versions
    versions="$(fvm api list 2>/dev/null | grep -oE '"flutterSdkVersion": *"[^"]+"' | sed 's/.*: *"//;s/"//' | paste -sd' ' -)"
    [[ -n "$versions" ]] || versions="$(fvm list 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -uV | paste -sd' ' -)"
    if [[ -n "$versions" ]]; then echo "$versions"; else echo "NONE — run 'fvm install stable'"; ok=1; fi
  fi
  printf '  %-22s ' "scripts reachable"
  if curl -fsSL "$BASE_URL/setup.sh" >/dev/null 2>&1; then echo "yes"; else echo "NO"; ok=1; fi
  return $ok
}

self_update() {
  local self
  self="$(command -v fsg || true)"
  [[ -n "$self" ]] || die "cannot locate the installed fsg on PATH"

  if command -v brew >/dev/null && [[ "$self" == "$(brew --prefix)"/* ]]; then
    echo "fsg was installed with Homebrew — update it that way:"
    echo "  brew update && brew upgrade fsg"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  curl -fsSL "$BASE_URL/fsg" -o "$tmp" || die "download failed"
  head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' || die "downloaded file is not fsg"
  if [[ -w "$self" ]]; then
    install -m 755 "$tmp" "$self"
  else
    sudo install -m 755 "$tmp" "$self"
  fi
  rm -f "$tmp"
  echo "fsg updated: $("$self" --version)"
}

case "${1:-}" in
  create)      shift; run_script setup.sh "$@" ;;
  add-feature) shift; run_script add-feature.sh "$@" ;;
  doctor)      shift; doctor ;;
  update)      shift; self_update ;;
  -v|--version) echo "fsg $VERSION" ;;
  ""|-h|--help) usage ;;
  *) echo "fsg: unknown subcommand '$1'" >&2; echo >&2; usage >&2; exit 1 ;;
esac
